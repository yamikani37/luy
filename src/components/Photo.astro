---
// A photo slot. Until real photos arrive it shows a clearly labelled placeholder.
// To add a photo: put it in src/assets/ and pass it as `src` (an imported image) with `alt`.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Seal from './Seal.astro';
interface Props { src?: ImageMetadata; alt?: string; label: string; class?: string; eager?: boolean; }
const { src, alt = '', label, class: cls, eager = false } = Astro.props;
---
{src ? (
  <div class:list={['photo', cls]}>
    <Image src={src} alt={alt} widths={[400, 800, 1200]} sizes="(max-width: 820px) 100vw, 50vw" loading={eager ? 'eager' : 'lazy'} />
  </div>
) : (
  <div class:list={['photo', 'photo--empty', cls]} role="img" aria-label={`Photo coming soon: ${label}`}>
    <div class="photo__label"><Seal variant="mark" size={44} /><span>Photo: {label}</span></div>
  </div>
)}
