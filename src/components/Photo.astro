---
// A photo slot. Photos are uploaded by the owner in Sanity; until one is added it shows a clearly labelled placeholder.
import Seal from './Seal.astro';
import { hasPhoto, photoAttrs, type SanityPhoto } from '../lib/sanity';
interface Props { photo?: SanityPhoto | null; label: string; class?: string; eager?: boolean; sizes?: string; }
const { photo, label, class: cls, eager = false, sizes = '(max-width: 820px) 100vw, 50vw' } = Astro.props;
---
{hasPhoto(photo) ? (
  <div class:list={['photo', cls]}>
    <img {...photoAttrs(photo)} sizes={sizes} alt={photo.alt ?? ''} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
  </div>
) : (
  <div class:list={['photo', 'photo--empty', cls]} role="img" aria-label={`Photo coming soon: ${label}`}>
    <div class="photo__label"><Seal variant="mark" size={44} /><span>Photo: {label}</span></div>
  </div>
)}
