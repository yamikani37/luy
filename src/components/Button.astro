---
import Icon from './Icon.astro';
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'dark' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  icon?: 'chat' | 'arrow';
  label?: string; // accessible name when the visible text is short, e.g. "Order this"
  class?: string;
}
const { href, variant = 'primary', size = 'md', icon, label, class: cls } = Astro.props;
const external = /^https?:/.test(href);
---
<a
  href={href}
  class:list={['btn', `btn--${variant}`, size !== 'md' && `btn--${size}`, cls]}
  aria-label={label}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  {icon === 'chat' && <Icon name="chat" size={size === 'lg' ? 22 : 18} />}
  <span class="btn__label"><slot /></span>
  {icon === 'arrow' && <Icon name="arrow" size={18} />}
</a>
