---
// In-house icons: 24px grid, 1.9px round strokes, currentColor.
interface Props { name: 'chat' | 'arrow' | 'phone' | 'pin' | 'instagram' | 'whisk' | 'heart' | 'sparkle' | 'leaf' | 'gift' | 'clock' | 'dot' | 'pot'; size?: number; }
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'chat' && (<><path d="M20 11.5a8 8 0 0 1-11.7 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z" /><path d="M9 10.5h6M9 13.5h4" /></>)}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'phone' && <path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" />}
  {name === 'pin' && (<><path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11Z" /><circle cx="12" cy="10" r="2.5" /></>)}
  {name === 'instagram' && (<><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="3.8" /><path d="M17 7h.01" /></>)}
  {name === 'whisk' && (<><path d="M4 20l6.5-6.5" /><path d="M10.5 13.5c-1.8-3.6-.4-8.4 3.2-9.8 2.4-.9 5.3.8 6 3.2 1.2 3.9-3.4 7.2-9.2 6.6Z" /><path d="M13 6.5c1 2.5.8 5-1.2 7M16.8 8.2c-.4 2.3-2 4.2-4.8 5.2" /></>)}
  {name === 'heart' && <path d="M12 20s-7.5-4.5-7.5-10A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 7.5 3c0 5.5-7.5 10-7.5 10Z" />}
  {name === 'sparkle' && <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18" />}
  {name === 'leaf' && (<><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z" /><path d="M5 19l7-7" /></>)}
  {name === 'gift' && (<><rect x="4" y="9" width="16" height="11" rx="2" /><path d="M4 13h16M12 9v11" /><path d="M12 9c-2 0-4.5-.5-4.5-2.5S10 4 12 9Zm0 0c2 0 4.5-.5 4.5-2.5S14 4 12 9Z" /></>)}
  {name === 'clock' && (<><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>)}
  {name === 'pot' && (<><path d="M4 11h16v3a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6v-3Z" /><path d="M2.5 11h19M9 7.5c0-1 .8-1.5.8-2.5M12.5 7.5c0-1 .8-1.5.8-2.5" /></>)}
  {name === 'dot' && <circle cx="12" cy="12" r="3" fill="currentColor" />}
</svg>
