---
// One menu: sticky category tabs + a section per category. Used by both Bakes and Kitchen.
import ItemCard from './ItemCard.astro';
import type { MenuCategory } from '../data/menu';
interface Props { categories: readonly MenuCategory[]; }
const { categories } = Astro.props;
---
<div class="tabs-bar">
  <div class="container">
    <nav class="tabs" aria-label="Menu categories" data-tabs>
      <span class="tabs__ind" aria-hidden="true" data-tabs-ind></span>
      {categories.map((c, i) => <a class="tabs__tab" href={`#${c.id}`} data-tab={c.id} aria-current={i === 0 ? 'true' : undefined}>{c.title}</a>)}
    </nav>
  </div>
</div>

<div class="container">
  {categories.map((c) => (
    <section class="menu-cat" id={c.id} aria-labelledby={`${c.id}-title`} data-cat>
      <div class="menu-cat__head">
        <h2 class="h2" id={`${c.id}-title`} data-reveal>{c.title}</h2>
        <p data-reveal style="--i:1">{c.blurb}</p>
      </div>
      <div class="menu-grid">
        {c.items.map((item, i) => <ItemCard item={item} category={c.category} categoryTitle={c.title} i={i} showPhoto={c.items.some((it) => it.photo?.asset)} />)}
      </div>
    </section>
  ))}
</div>

<script>
  // Category tabs: a pistachio pill slides to whichever section you're reading.
  const bar = document.querySelector<HTMLElement>('[data-tabs]');
  const ind = document.querySelector<HTMLElement>('[data-tabs-ind]');
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
  const cats = Array.from(document.querySelectorAll<HTMLElement>('[data-cat]'));
  let current = '';

  function setActive(id: string | undefined) {
    if (!id || !bar || !ind || id === current) return;
    current = id;
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.classList.toggle('is-active', on);
      if (on) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current');
      if (on) {
        ind.style.width = `${t.offsetWidth}px`;
        ind.style.transform = `translateX(${t.offsetLeft - 5}px)`;
        ind.style.opacity = '1';
        bar.scrollTo({ left: t.offsetLeft - bar.clientWidth / 2 + t.offsetWidth / 2, behavior: 'smooth' });
      }
    });
  }

  if (cats.length) {
    const hash = location.hash.slice(1);
    setActive(cats.some((c) => c.id === hash) ? hash : cats[0].id);
    const io = new IntersectionObserver((entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) setActive(visible[0].target.id);
    }, { rootMargin: '-160px 0px -55% 0px' });
    cats.forEach((c) => io.observe(c));
    tabs.forEach((t) => t.addEventListener('click', () => setActive(t.dataset.tab)));
    window.addEventListener('resize', () => { const id = current; current = ''; setActive(id); });
  }
</script>
