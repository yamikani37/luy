---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import MenuSwitch from '../components/MenuSwitch.astro';
import MenuBoard from '../components/MenuBoard.astro';
import OrderBanner from '../components/OrderBanner.astro';
import { bakes } from '../data/menu';
import { askLink } from '../lib/whatsapp';
---
<Base title="Menu · Bakes" description="Prices for cupcakes, bento cakes, flat, tall and tiered cakes. Tap Order this and WhatsApp opens with your order filled in.">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__text">
        <p class="eyebrow" data-reveal>Our menu</p>
        <h1 class="display-lg" data-reveal style="--i:1">Bakes, <span class="accent">made to order.</span></h1>
        <p class="lead" data-reveal style="--i:2">Everything is baked fresh. Tap <strong>Order this</strong> on any item and WhatsApp opens with your order already written.</p>
      </div>
      <Seal size={150} spin />
    </div>
    <div class="container"><MenuSwitch current="bakes" /></div>
  </section>

  <MenuBoard categories={bakes} />

  <OrderBanner eyebrow="Need help choosing?" title="Not sure what to pick?" body="Send us a message and we’ll help you choose the right size and style for your occasion." cta="Ask on WhatsApp" href={askLink()} />
</Base>
