---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { askLink } from '../lib/whatsapp';
---
<Base title="Contact" description="Order or ask a question on WhatsApp. Luyando Mooya's Kitchen, Ndola Villa, Ndola.">
  <section class="page-hero">
    <div class="container page-hero__text">
      <p class="eyebrow" data-reveal>Contact</p>
      <h1 class="display-lg" data-reveal style="--i:1">We’d love to <span class="accent">hear from you.</span></h1>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container contact-grid">
      <div class="wa-card" data-reveal>
        <div style="display:flex;flex-direction:column;gap:var(--space-4);position:relative;z-index:1">
          <p class="eyebrow">Fastest way to reach us</p>
          <h2 class="h1">Chat with us on WhatsApp</h2>
          <p>Ask about sizes, flavours, dates or a custom design. We’ll get back to you as soon as we can.</p>
        </div>
        <div style="position:relative;z-index:1"><Button href={askLink()} variant="dark" size="lg" icon="chat">Start a chat</Button></div>
        <Seal tone="pistachio" size={220} spin />
      </div>
      <ul class="info-list">
        <li class="info" data-reveal style="--i:1">
          <span class="info__icon"><Icon name="chat" /></span>
          <div><p class="info__label">WhatsApp</p><p class="info__value"><a href={askLink()} target="_blank" rel="noopener">{site.phones[0].display}</a></p></div>
        </li>
        <li class="info" data-reveal style="--i:2">
          <span class="info__icon"><Icon name="phone" /></span>
          <div><p class="info__label">Phone</p>
            <p class="info__value">{site.phones.map((p, i) => <>{i > 0 && ' / '}<a href={`tel:${p.tel}`}>{p.display}</a></>)}</p></div>
        </li>
        <li class="info" data-reveal style="--i:3">
          <span class="info__icon"><Icon name="pin" /></span>
          <div><p class="info__label">Location</p><p class="info__value">{site.location}</p><p class="muted" style="font-size:14px">Pickup or delivery. We’ll share directions when you order.</p></div>
        </li>
        <li class="info" data-reveal style="--i:4">
          <span class="info__icon"><Icon name="instagram" /></span>
          <div><p class="info__label">Instagram</p><p class="info__value">{site.instagramUrl ? <a href={site.instagramUrl} target="_blank" rel="noopener">{site.instagramName}</a> : site.instagramName}</p></div>
        </li>
      </ul>
    </div>
  </section>
</Base>
